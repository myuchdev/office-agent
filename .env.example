# ===== 大模型配置（默认 DeepSeek，OpenAI 兼容，便宜稳定，学生友好）=====
# 申请地址：https://platform.deepseek.com/  注册后创建 API Key
DEEPSEEK_API_KEY=sk-在此填入你的key

# 如改用其他 OpenAI 兼容服务（通义千问 / Kimi / 智谱 / 本地 Ollama 等），
# 只需修改下面两项，并把上面的 key 换成对应服务的 key（也可用 OPENAI_API_KEY）。
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ===== RAG 本地 Embedding（无需联网、无需额外 key）=====
EMBEDDING_DIM=512
# 每次检索返回给大模型的文本块数量（增大召回更全，但 token 更多）
RETRIEVAL_TOP_K=4
# 混合检索中关键词( IDF )分数的权重：0=纯向量检索，0.8=向量+关键词混合（推荐）
RETRIEVAL_KEYWORD_WEIGHT=0.8

# 想让 RAG 用语义云端 embedding（可选）：
# EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-xxx
